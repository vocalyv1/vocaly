# Modèle des variables d'environnement (valeurs réelles uniquement dans Vercel, jamais dans le dépôt).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
RESEND_FROM=

# Paiement Mobile Money (PawaPay). Sans jeton, la page Abonnement renvoie vers WhatsApp.
# Callback à déclarer dans le tableau de bord PawaPay : https://<votre-domaine>/api/webhooks/pawapay
PAWAPAY_API_TOKEN=
PAWAPAY_ENV=sandbox

# Paiement par carte (Stripe Checkout). Webhook : https://<votre-domaine>/api/webhooks/stripe
# Événements : checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed, checkout.session.expired
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Tâche quotidienne Vercel Cron (rappels de renouvellement, alertes de minutes, récapitulatif du lundi)
CRON_SECRET=
