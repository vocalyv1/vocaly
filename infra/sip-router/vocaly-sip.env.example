# Copiez ce fichier en vocaly-sip.env et remplissez-le sur le serveur. Ne le mettez jamais dans Git.
# Adresse IP publique fixe du serveur.
PUBLIC_IP=203.0.113.10
# Numéro unique fourni par Airtel, au format international.
VOCALY_NUMBER=+242000000000
# Adresses IP d'où Airtel envoie les appels (expression régulière), données par le technicien Airtel.
AIRTEL_IPS=^(198\.51\.100\.1|198\.51\.100\.2)$
# Serveur SIP d'Airtel pour les appels sortants (transferts vers un humain).
AIRTEL_HOST=sip.exemple-airtel.cg
AIRTEL_PORT=5060
AIRTEL_TRANSPORT=udp
# ElevenLabs (plateforme vocale).
EL_HOST=sip.rtc.elevenlabs.io
EL_PORT=5060
EL_TRANSPORT=tcp
# Identifiants que la plateforme vocale utilise pour passer des transferts par ce routeur.
# Les mêmes valeurs vont dans Vercel : SIP_ROUTER_USER et SIP_ROUTER_PASSWORD.
EL_USER=vocaly-el
EL_PASSWORD=change-moi-par-un-long-mot-de-passe-aleatoire
